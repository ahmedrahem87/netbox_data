{# Loop through interfaces using the global 'interfaces' list #}
{% for iface in interfaces %}
interface {{ iface.name }}
 {% if iface.description %}description {{ iface.description }}{% endif %}
 {# Check if the interface has any IP addresses assigned #}
 {% for ip in iface.ip_addresses.all() %}
 ip address {{ ip.address.ip }} {{ ip.address.netmask }}
 {% endfor %}
 no shutdown
!
{% endfor %}

{# OSPF Logic - Checking for lo0 specifically #}
{% for iface in interfaces if iface.name == 'lo0' %}
router ospf 100
 {% for ip in iface.ip_addresses.all() %}
 router-id {{ ip.address.ip }}
 {% endfor %}
 network 150.1.0.0 0.0.255.255 area 0
 network 155.1.0.0 0.0.255.255 area 0
!
{% endfor %}

{# BGP Logic - Looking into the Config Context #}
{% if config_context %}
 {# Since config_context is a list in your data, we loop through it #}
 {% for ctx in config_context if ctx.bgp is defined %}
router bgp {{ ctx.bgp.as_number }}
 bgp log-neighbor-changes
 {% for neighbor in ctx.bgp.neighbors %}
 neighbor {{ neighbor.ip }} remote-as {{ neighbor.remote_as }}
 neighbor {{ neighbor.ip }} update-source lo0
 {% endfor %}
 !
 {% endfor %}
{% endif %}
