hostname {{ device.name }}
!
ip domain name example.com
ipv6 unicast-routing
!
username adam privilege 15 secret 9 $9$mIaRVsm1z68E/k$OZzv/Mu4G/Hq6WKwhCEbDQzr9NvMQXrsG8YOIEK/JBU
!
{% set full_context = device.get_config_context() %}

{# Loop through interfaces via the device object #}
{% for iface in device.interfaces.all() %}
interface {{ iface.name }}
 {% if iface.description %}description {{ iface.description }}{% endif %}
 {% for ip in iface.ip_addresses.all() %}
 ip address {{ ip.address.ip }} {{ ip.address.netmask }}
 {% endfor %}
 no shutdown
!
{% endfor %}

{# OSPF Logic #}
{% if full_context.ospf is defined %}
router ospf {{ full_context.ospf.process_id }}
 {% for iface in device.interfaces.all() if iface.name == 'Loopback0' %}
 {% for ip in iface.ip_addresses.all() %}
 router-id {{ ip.address.ip }}
 {% endfor %}
 {% endfor %}
 {% for net in full_context.ospf.networks %}
 network {{ net.network }} {{ net.wildcard }} area {{ net.area }}
 {% endfor %}
!
{% endif %}


{# BGP Logic - Looking at device.get_config_context() #}
{% if full_context.bgp is defined %}
router bgp {{ full_context.bgp.as_number }}
 bgp log-neighbor-changes
 {% for n in full_context.bgp.neighbors %}
 neighbor {{ n.ip }} remote-as {{ n.remote_as }}
 neighbor {{ n.ip }} update-source Loopback0
 {% endfor %}
!
{% endif %}
