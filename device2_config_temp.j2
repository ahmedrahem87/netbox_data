hostname {{ device.name }}
!
ip domain name example.com
ipv6 unicast-routing
!
username adam privilege 15 secret 9 $9$mIaRVsm1z68E/k$OZzv/Mu4G/Hq6WKwhCEbDQzr9NvMQXrsG8YOIEK/JBU
!
{# Loop through interfaces #}
{% for iface in interfaces %}
interface {{ iface.name }}
 {% if iface.description %}description {{ iface.description }}{% endif %}
 {% if iface.ip_addresses %}
  {% for ip_obj in iface.ip_addresses %}
   {% if ip_obj.address %}
 ip address {{ ip_obj.address.split('/')[0] }} {{ '255.255.255.255' if '/32' in ip_obj.address else '255.255.255.0' }}
   {% endif %}
  {% endfor %}
 {% endif %}
 no shutdown
!
{% endfor %}

{# OSPF Logic #}
{% for iface in interfaces if iface.name == 'lo0' %}
router ospf 100
 {% if iface.ip_addresses and iface.ip_addresses[0].address %}
 router-id {{ iface.ip_addresses[0].address.split('/')[0] }}
 {% endif %}
 network 150.1.0.0 0.0.255.255 area 0
 network 155.1.0.0 0.0.255.255 area 0
!
{% endfor %}

{# BGP Logic - Direct loop over the config_context list #}
{% for context in config_context if context.bgp is defined %}
router bgp {{ context.bgp.as_number }}
 bgp log-neighbor-changes
 {% if context.bgp.neighbors %}
  {% for neighbor in context.bgp.neighbors %}
 neighbor {{ neighbor.ip }} remote-as {{ neighbor.remote_as }}
 neighbor {{ neighbor.ip }} update-source lo0
  {% endfor %}
 {% endif %}
!
{% endfor %}
